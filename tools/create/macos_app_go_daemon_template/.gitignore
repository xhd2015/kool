# Go daemon build output
.build/

# macOS menu-bar app (Swift PM + bundle)
__PROJECT_NAME__-swift/.build/
__PROJECT_NAME__-swift/.swiftpm/

# Nested / monorepo-safe (SPM + go .build under any subdir)
**/.build/
**/.swiftpm/

# Xcode
